{
  "name": "webstatus",
  "version": "2.5.2",
  "description": "网站状态监控 WebStatus - 开源自托管网站状态监控系统 (Node.js + Express + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "tailwindcss -i src/views/assets/css/input.css -o src/views/assets/css/app.css --minify"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "monitor",
    "uptime",
    "status",
    "website",
    "监控",
    "状态监控"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "multer": "^2.0.0",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.14"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
